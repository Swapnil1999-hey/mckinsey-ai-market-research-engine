GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1
GEMINI_TIMEOUT_SECONDS=60
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_LIMIT=3
MAX_SOURCE_CHARS=5000
NEXT_PUBLIC_API_URL=http://localhost:8000
# VECTOR_DB_URL is optional when using pgvector through Supabase
VECTOR_DB_URL=

# Database: Supabase PostgreSQL + pgvector
# Paste the connection string from Supabase Project Settings -> Database.
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres
# auto = use database when configured, otherwise bundled demo CSVs; database = require DB; demo = force CSVs
DATA_SOURCE=auto
EMBEDDING_DIM=1536

# Fast Research Mode
FAST_RESEARCH_MODE=true
MAX_RESEARCH_SOURCES=9
MAX_EVIDENCE_RECORDS=30

# Research provider fallbacks (optional)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=25
SERPER_API_KEY=
SERPER_TIMEOUT_SECONDS=25

# LLM fallbacks (optional; used when Gemini is unavailable/quota exhausted)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALT_LLM_TIMEOUT_SECONDS=60
